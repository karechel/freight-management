        "description": "create table \"ReferenceFormat\"",
        "sql": "CREATE TABLE \"public\".\"ReferenceFormat\" (\n  \"createdAt\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"documentType\" text NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"resetPolicy\" text DEFAULT 'never' NOT NULL,\n  \"template\" text NOT NULL,\n  \"updatedAt\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"updatedById\" int4,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"ReferenceFormat_documentType_check_ea19f9ed\" CHECK (\"documentType\" IN ('shipment', 'quotation', 'invoice', 'booking', 'credit_note', 'payment', 'customs_entry')),\n  CONSTRAINT \"ReferenceFormat_resetPolicy_check_aab625b6\" CHECK (\"resetPolicy\" IN ('never', 'yearly', 'monthly')),\n  CONSTRAINT \"reference_format_has_sequence_31975ed0\" CHECK (template LIKE '%{SEQ:%}%')\n)",
        "params": []
      }
    ],
