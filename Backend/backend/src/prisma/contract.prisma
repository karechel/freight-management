// use prisma-8

// Freight management data contract. Design and decisions: docs/database-design.md.
//
// Conventions
// - Money: KES only, Numeric(14, 2). Never floating point.
// - Instants (events, deadlines, tracking): timestamptz(3), JavaScript Date in code.
// - Calendar dates (validity, issue/due dates, cheque dates): date, "YYYY-MM-DD" string in code.
// - Statuses: text enums enforced by CHECK constraints; allowed transitions are enforced in
//   the NestJS services.
// - Business records are never hard-deleted (onDelete defaults to Restrict). Only rows owned
//   by a parent (lines, contacts, roles, milestones) cascade.
// - updatedAt is set by application code (Prisma 8 has no lifecycle hooks).

types {
  Money    = Numeric(14, 2)
  Quantity = Numeric(12, 3)
  Percent  = Numeric(5, 2)
  Instant  = TimestamptzJsDate(3)
  CalDate  = DateString
}

