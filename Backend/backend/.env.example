# PostgreSQL connection string used by Prisma (see src/prisma/contract.prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/freight_management

# Port the NestJS API listens on (defaults to 3001 if unset)
PORT=3001

# Secret that signs login tokens. At least 32 random characters; never commit a real value.
JWT_SECRET=replace-with-at-least-32-random-characters

# Comma-separated browser origins allowed to call the API (defaults to the local frontend)
CORS_ORIGINS=http://localhost:3000

# First administrator, created by `npm run db:seed`. At least 12 characters; never commit a real value.
ADMIN_EMAIL=admin@freight-demo.example
ADMIN_PASSWORD=replace-with-a-strong-password

# Password for the fictional staff accounts created by `npm run db:seed:demo` (development only).
DEMO_USER_PASSWORD=replace-with-a-strong-password
